# Salin menjadi .env.local lalu isi semua nilai dari proyek Supabase Anda.

# URL proyek Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Anon key untuk browser dan server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key khusus server, untuk registrasi dan penghapusan pengguna.
# Jangan gunakan prefix NEXT_PUBLIC_ atau membagikan nilai ini ke browser.
SUPABASE_SERVICE_ROLE_KEY=
